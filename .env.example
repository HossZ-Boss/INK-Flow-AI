# Required server-side OpenAI authentication. Never commit a real key.
OPENAI_API_KEY=your_openai_api_key_here

# Optional runtime controls
# GPT-6 Astra is OpenAI's highest-capability current general model.
OPENAI_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=low
# Used only when OPENAI_MODEL selects a non-reasoning model.
OPENAI_TEMPERATURE=0.0
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

# Learning layer: staff-reviewed outcomes posted to /api/v1/learning/feedback
# are stored here and reused for artist and price suggestions.
LEARNING_ENABLED=true
LEARNING_INDEX_PATH=data/learning.faiss
